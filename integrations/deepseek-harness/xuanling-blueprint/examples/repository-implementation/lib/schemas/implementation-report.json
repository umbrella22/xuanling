{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "checkout", "commands", "receipts", "blockers"],
  "properties": {
    "outcome": { "type": "string", "enum": ["delivered", "blocked", "partial"] },
    "checkout": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode"],
        "properties": {
          "command": { "type": "string" },
          "exitCode": { "type": "number" }
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" }
  }
}
